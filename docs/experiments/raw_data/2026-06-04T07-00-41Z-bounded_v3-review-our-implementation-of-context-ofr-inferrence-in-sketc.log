87: 			messages = append(messages, Message{Kind: "message", Role: "user", Content: v.Content})
88: 		case logs.AssistantMessageRecord:
89: 			messages = append(messages, Message{Kind: "message", Role: "assistant", Content: v.Content})
90: 		case logs.ToolCallRequestRecord:
91: 			messages = append(messages, Message{Kind: "tool_call", Role: "assistant_tool_call", Name: v.ToolName, CallID: v.CallID, Content: v.Arguments})
92: 		case logs.ToolCallResultRecord:
93: 			messages = append(messages, Message{Kind: "tool_result", Role: "tool", Name: v.ToolName, CallID: v.CallID, Content: v.Content})
94: 		}
95: 	}
96: 	return messages
97: }
