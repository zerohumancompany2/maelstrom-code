41: 	refreshEvery := opts.RefreshEveryTurns
42: 	if refreshEvery <= 0 {
43: 		refreshEvery = 12
44: 	}
45: 	c.mu.Lock()
46: 	defer c.mu.Unlock()
47: 	if c.lastText != "" && turn-c.lastTurn < refreshEvery {
48: 		return c.lastText
49: 	}
50: 	summary := buildRepoSummary(opts)
51: 	c.lastTurn = turn
52: 	c.lastText = summary
53: 	return summary
54: }
