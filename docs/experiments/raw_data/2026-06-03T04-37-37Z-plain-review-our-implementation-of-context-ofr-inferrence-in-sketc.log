61: 		rec, ok := history.Records[i].(logs.ContextSnapshotRecord)
62: 		if ok && rec.LogicalKey == logicalKey {
63: 			copy := rec
64: 			return &copy
65: 		}
66: 	}
67: 	return nil
68: }
